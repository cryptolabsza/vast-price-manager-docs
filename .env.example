# Copy this file to .env (docker compose reads .env automatically) and
# fill in the values below, then follow README.md.

# The exact, signed, digest-pinned VPM image to run. Look up the current
# version in RELEASES.md and verify its signature with docs/verify-image.md
# before you pull it. Never replace this with ":latest" — see
# docs/upgrade-and-backup.md for why.
VPM_IMAGE=ghcr.io/cryptolabsza/vast-price-manager:0.3.2@sha256:b99d1c88723e0182ca297725219ed65e603ed3fa939d1d8caa61b1417940e927

# The hostname you will open in your browser. Must match the site block
# you use in Caddyfile (the default is "localhost" for trying VPM out on
# your own machine).
VPM_ALLOWED_HOSTS=localhost

# Host ports Caddy publishes for HTTPS/HTTP. Change these if 443 and/or 80
# are already used on this machine — see docs/troubleshooting.md.
HOST_HTTPS_PORT=443
HOST_HTTP_PORT=80

# Your Vast.ai numeric account/user ID. Required before VPM will accept a
# Vast API key on the Credentials page. See docs/first-run.md — "Find your
# Vast account ID". Leave this empty until you get there; VPM works fine
# without it, it just will not let you add a key yet.
VPM_EXPECTED_ACCOUNT_ID=
