# Copy this file to .env (docker compose reads .env automatically) and
# fill in the values below, then follow README.md.

# Exact signed 0.4.4 image from RELEASES.md. Never replace this with ":latest" — see
# docs/upgrade-and-backup.md for why.
VPM_IMAGE=ghcr.io/cryptolabsza/vast-price-manager:0.4.4@sha256:51811d3388fc6142212eb6d21746fc884e482975dd218a1710d632c0d1f61dd5

# The hostname you will open in your browser. Must match the site block
# you use in Caddyfile (the default is "localhost" for trying VPM out on
# your own machine).
VPM_ALLOWED_HOSTS=localhost

# Host ports Caddy publishes for HTTPS/HTTP. Change these if 443 and/or 80
# are already used on this machine — see docs/troubleshooting.md.
HOST_HTTPS_PORT=443
HOST_HTTP_PORT=80

# Your Vast.ai numeric account/user ID. Required before VPM will accept a
# Vast API key on the Credentials page. See docs/first-run.md — "Find your
# Vast account ID". Leave this empty until you get there; VPM works fine
# without it, it just will not let you add a key yet.
VPM_EXPECTED_ACCOUNT_ID=

# This manual standalone recipe requires this value before it accepts a key.
# In the appliance wizard it is optional: a configured value always overrides
# the account the wizard discovers. See docs/setup-wizard.md.

# This manual Caddy recipe follows the account-ID/CLI path by default. Set to
# true only when deliberately using guided local-auth setup instead.
VPM_SETUP_ENABLED=false

# Keep provider writes disabled until you have reviewed docs/first-run.md.
# Setting this to true requires `docker compose up -d` to recreate the container,
# followed by the dashboard confirmation and per-machine opt-in.
VPM_WRITES_ENABLED=false
